<script>
    document.addEventListener('DOMContentLoaded', () => {
      const checkoutBar = document.getElementById('checkout-bar');
      let lastScrollY = window.scrollY;

      // Simple animation on scroll
      window.addEventListener('scroll', () => {
        if (window.scrollY > lastScrollY) {
          // Scrolling down - slightly tuck away
          checkoutBar.style.transform = 'translateY(10px) scale(0.98)';
          checkoutBar.style.opacity = '0.9';
        } else {
          // Scrolling up - bring back
          checkoutBar.style.transform = 'translateY(0) scale(1)';
          checkoutBar.style.opacity = '1';
        }
        lastScrollY = window.scrollY;
      });

      // Product card haptic feedback simulation
      const cards = document.querySelectorAll('.active\\:scale-\\[0\\.98\\]');
      cards.forEach(card => {
        card.addEventListener('click', () => {
          // Add a temporary highlight effect
          const overlay = document.createElement('div');
          overlay.className = 'absolute inset-0 bg-primary/5 pointer-events-none';
          card.appendChild(overlay);
          setTimeout(() => overlay.remove(), 200);
        });
      });
    });
